    AutoEventRewards = true,
    AutoFreeGifts = true,
    UnlockGamepasses = true,
    AutoReinjectOnTeleport = true,
    FarmRadius = 250
}

local function saveConfig()
    pcall(function()
        if safeWriteFile then
            local data = HttpService:JSONEncode(State)
            safeWriteFile(ConfigFile, data)
        end
    end)
end

local function loadConfig()
    pcall(function()
        if safeIsFile and safeIsFile(ConfigFile) and safeReadFile then
            local raw = safeReadFile(ConfigFile)
            local decoded = HttpService:JSONDecode(raw)
            if type(decoded) == "table" then
                for k, v in pairs(decoded) do
                    if State[k] ~= nil then
                        State[k] = v
                    end
                end
            end
        end
    end)
end

loadConfig()

local function setupAutoInject()
    if queueTeleport then
        LocalPlayer.OnTeleport:Connect(function(teleportState)
            if State.AutoReinjectOnTeleport then
                pcall(function()
                    if safeIsFile and safeIsFile("c4_psx.lua") then
                        queueTeleport('loadstring(readfile("c4_psx.lua"))()')
                    else
                        queueTeleport([[
                            task.wait(2)
                            local Framework = game:GetService("ReplicatedStorage"):WaitForChild("Framework")
                            local Library = require(Framework:WaitForChild("Library"))
                            while not Library.Loaded do task.wait(0.1) end
                        ]])
                    end
                end)
            end
        end)
    end
end

task.spawn(setupAutoInject)

local function patchGamepasses()
    pcall(function()
        if Library.Gamepasses and Library.Gamepasses.Owns then
            if safeHookFunction then
                pcall(function()
                    safeHookFunction(Library.Gamepasses.Owns, newcclosure(function(id)
                        if State.UnlockGamepasses then return true end
                        return true
                    end))
                end)
            end
            makeTableWritable(Library.Gamepasses)
            Library.Gamepasses.Owns = function(id)
                if State.UnlockGamepasses then return true end
                return true
            end
        end

        local save = Library.Save.Get()
        if save then
            makeTableWritable(save)
            save.Gamepasses = save.Gamepasses or {}
            makeTableWritable(save.Gamepasses)
            if Library.Directory and Library.Directory.Gamepasses then
                for _, pass in pairs(Library.Directory.Gamepasses) do
                    if pass.ID then
                        save.Gamepasses[tostring(pass.ID)] = true
                        save.Gamepasses[pass.ID] = true
                    end
                end
            end
        end
    end)
end

task.spawn(patchGamepasses)

local function getCoinsFolder()
    if Library.Things and Library.Things:FindFirstChild("Coins") then
        return Library.Things.Coins
    end
    local things = workspace:FindFirstChild("__THINGS")
    if things and things:FindFirstChild("Coins") then
        return things.Coins
    end
    return nil
end

local function getAvailableAreas()
    local areas = {"Current", "All"}
    local seen = {}
    local coins = getCoinsFolder()
    if coins then
        for _, c in ipairs(coins:GetChildren()) do
            local a = c:GetAttribute("Area")
            if a and a ~= "" and not seen[a] then
                seen[a] = true
                table.insert(areas, a)
            end
        end
    end
    return areas
end

local function getCurrentPlayerArea()
    local area = nil
    pcall(function()
        area = Library.WorldCmds.GetArea()
    end)
    if not area then
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        if root then
            local coins = getCoinsFolder()
            local minDist = 9999
            if coins then
                for _, c in ipairs(coins:GetChildren()) do
                    local pos = c:FindFirstChild("POS") or c:FindFirstChildOfClass("BasePart")
                    if pos then
                        local d = (pos.Position - root.Position).Magnitude
                        if d < minDist then
                            minDist = d
                            area = c:GetAttribute("Area")
                        end
                    end
                end
            end
        end
    end
    return area or "Town"
end

local function getEquippedPetUids()
    local uids = {}
    pcall(function()
        for _, pet in pairs(Library.PetCmds.GetEquipped()) do
            if type(pet) == "table" and pet.uid then
                table.insert(uids, pet.uid)
            elseif type(pet) == "string" then
                table.insert(uids, pet)
            end
        end
    end)
    if #uids == 0 then
        pcall(function()
            local save = Library.Save.Get()
            if save and save.Pets then
                for _, pet in pairs(save.Pets) do
                    if pet.e or pet.equipped then
                        table.insert(uids, pet.uid)
                    end
                end
            end
        end)
    end
    return uids
end

local function getTargetCoin(rootPos)
    local coins = getCoinsFolder()
    if not coins then return nil end

    local targetArea = State.SelectedArea
    if targetArea == "Current" then
        targetArea = getCurrentPlayerArea()
    end

    local bestCoin = nil
    local bestDist = State.FarmRadius

    for _, coin in ipairs(coins:GetChildren()) do
        local posPart = coin:FindFirstChild("POS") or coin:FindFirstChild("Coin") or coin:FindFirstChildOfClass("BasePart")
        local coinId = coin:GetAttribute("ID") or coin.Name
        local coinArea = coin:GetAttribute("Area") or ""
        local coinName = string.lower(coin:GetAttribute("Name") or coin.Name)

        if posPart and coinId then
            local areaMatch = (State.SelectedArea == "All") or (coinArea == targetArea)
            local modeMatch = (State.TargetMode == "All Coins") or string.find(coinName, "chest")

            if areaMatch and modeMatch then
                local dist = (posPart.Position - rootPos).Magnitude
                if dist < bestDist then
                    bestDist = dist
                    bestCoin = coin
                end
            end
        end
    end

    return bestCoin
end

task.spawn(function()
    while true do
        if State.AutoFarm then
            pcall(function()
                local char = LocalPlayer.Character
                local root = char and char:FindFirstChild("HumanoidRootPart")
                if not root then return end

                local coinInstance = getTargetCoin(root.Position)
                if coinInstance then
                    local coinId = coinInstance:GetAttribute("ID") or coinInstance.Name
                    local posPart = coinInstance:FindFirstChild("POS") or coinInstance:FindFirstChildOfClass("BasePart")

                    if State.AutoTeleportToCoin and posPart then
                        root.CFrame = CFrame.new(posPart.Position + Vector3.new(0, 6, 0))
                    end

                    Library.Signal.Fire("Group Select Coin", coinInstance)

                    local petUids = getEquippedPetUids()
                    if #petUids > 0 then
                        local joinRes = Library.Network.Invoke("Join Coin", coinId, petUids)
                        if joinRes and type(joinRes) == "table" then
                            for petUid, accepted in pairs(joinRes) do
                                if accepted == true then
                                    Library.Network.Fire("Farm Coin", coinId, petUid)
                                end
                            end
                        else
                            for _, uid in ipairs(petUids) do
                                Library.Network.Fire("Farm Coin", coinId, uid)
                            end
                        end
                    end
                end
            end)
        end
        task.wait(0.2)
    end
end)

task.spawn(function()
    while true do
        if State.AutoOrbs then
            pcall(function()
                local orbsFolder = Library.Things and Library.Things:FindFirstChild("Orbs")
                if orbsFolder then
                    local list = {}
                    for _, orb in ipairs(orbsFolder:GetChildren()) do
                        table.insert(list, orb.Name)
                        if #list >= 60 then break end
                    end
                    if #list > 0 then
                        Library.Network.Fire("Claim Orbs", list)
                    end
                end
            end)
        end

        if State.AutoLootbags then
            pcall(function()
                local lootFolder = Library.Things and Library.Things:FindFirstChild("Lootbags")
                if lootFolder then
                    for _, bag in ipairs(lootFolder:GetChildren()) do
                        local pos = bag:IsA("BasePart") and bag.Position or Vector3.new(0, 0, 0)
                        Library.Network.Fire("Collect Lootbag", bag.Name, pos)
                    end
                end
            end)
        end
        task.wait(0.15)
    end
end)

task.spawn(function()
    while true do
        if State.AutoEventRewards then
            pcall(function()
                local save = Library.Save.Get()
                if save and Library.Shared and Library.Shared.EventRewards then
                    local stars = save.Stars or 0
                    for eventName, rewardTree in pairs(Library.Shared.EventRewards) do
                        local stage = (save.EventsRewardStage and save.EventsRewardStage[eventName]) or 0
                        local nextStage = stage + 1
                        local node = rewardTree[nextStage]

                        if node and stars >= (node.Cost or 0) then
                            Library.Network.Invoke("Events: Redeem Reward", eventName, nextStage)
                        end
                    end
                end
            end)
        end
        if State.AutoFreeGifts then
            pcall(function()
                for i = 1, 12 do
                    Library.Network.Invoke("Redeem Free Gift", i)
                end
                Library.Network.Invoke("Redeem Rank Rewards")
                Library.Network.Invoke("Redeem VIP Rewards")
            end)
        end
        task.wait(2.0)
    end
end)

