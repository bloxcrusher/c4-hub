local genv = (getgenv and getgenv()) or _G
local safeSetReadOnly = genv.setreadonly or (syn and syn.set_readonly)
local safeHookFunction = genv.hookfunction or (syn and syn.hook_function)
local safeMakeWritable = genv.make_writeable
local safeIsFile = genv.isfile
local safeReadFile = genv.readfile
local safeWriteFile = genv.writefile
local queueTeleport = genv.queue_on_teleport or (syn and syn.queue_on_teleport) or (fluxus and fluxus.queue_on_teleport)

local function makeTableWritable(tbl)
    if safeSetReadOnly then
        pcall(safeSetReadOnly, tbl, false)
    elseif safeMakeWritable then
        pcall(safeMakeWritable, tbl)
    end
end

local ConfigFile = "c4_psx_config.json"

