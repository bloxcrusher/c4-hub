local function createTab(name)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Text = name
    tabBtn.Size = UDim2.new(1, 0, 0, 26)
    tabBtn.Font = Enum.Font.SourceSansSemibold
    tabBtn.TextSize = 13
    tabBtn.TextColor3 = Color3.fromRGB(150, 165, 190)
    tabBtn.BackgroundColor3 = Color3.fromRGB(26, 32, 42)
    tabBtn.BorderSizePixel = 0
    tabBtn.AutoButtonColor = false
    tabBtn.Parent = Sidebar

    local btnCorner = Instance.new("UICorner")
    btnCorner.CornerRadius = UDim.new(0, 4)
    btnCorner.Parent = tabBtn

    local tabFrame = Instance.new("ScrollingFrame")
    tabFrame.Size = UDim2.new(1, 0, 1, 0)
    tabFrame.BackgroundTransparency = 1
    tabFrame.ScrollBarThickness = 3
    tabFrame.ScrollBarImageColor3 = Color3.fromRGB(60, 80, 110)
    tabFrame.Visible = false
    tabFrame.BorderSizePixel = 0
    tabFrame.Parent = Content

    local listLayout = Instance.new("UIListLayout")
    listLayout.Padding = UDim.new(0, 6)
    listLayout.Parent = tabFrame

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 10)
    pad.PaddingRight = UDim.new(0, 10)
    pad.Parent = tabFrame

    listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        tabFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 16)
    end)

    tabBtn.MouseButton1Click:Connect(function()
        for _, t in pairs(tabs) do
            t.Frame.Visible = false
            t.Btn.TextColor3 = Color3.fromRGB(150, 165, 190)
            t.Btn.BackgroundColor3 = Color3.fromRGB(26, 32, 42)
        end
        tabFrame.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabBtn.BackgroundColor3 = Color3.fromRGB(35, 110, 240)
    end)

    tabs[name] = {Frame = tabFrame, Btn = tabBtn}
    if not activeTab then
        activeTab = tabFrame
        tabFrame.Visible = true
        tabBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
        tabBtn.BackgroundColor3 = Color3.fromRGB(35, 110, 240)
    end
    return tabFrame
end

