-- 0. auto clear eggs (child listener + interval flush)
local eggsFolder = workspace:WaitForChild("Eggs")

eggsFolder.ChildAdded:Connect(function(child)
    if State.AutoClearEggs then
        task.defer(function()
            if child and child.Parent then
                child:Destroy()
            end
        end)
    end
end)

task.spawn(function()
    while true do
        if State.AutoClearEggs then
            pcall(function()
                if #eggsFolder:GetChildren() > 0 then
                    eggsFolder:ClearAllChildren()
                end
            end)
        end
        task.wait(0.5)
    end
end)

-- 1. tier pusher worker (chickens farm + tier upgrade remote)
task.spawn(function()
    while true do
        if State.FastChickenSpam then
            pcall(function()
                local total = Paper.Stats.GetValue("TotalChickens") or 0
                local tier = Paper.Stats.GetValue("BuyTierLevel") or 1
                local cash = Paper.Stats.GetValue("Cash") or 0
                local reqChickens = Chickens.GetUpgTierReq(tier)

                if reqChickens and total < reqChickens then
                    local cost = Chickens.GetBuyChickenCost(total, tier, 25)
                    if cash >= cost then
                        Network.InvokeServer("Buy Chickens", 25)
                    end
                end
            end)
        end

        if State.AutoBuyTier then
            pcall(function()
                local total = Paper.Stats.GetValue("TotalChickens") or 0
                local tier = Paper.Stats.GetValue("BuyTierLevel") or 1
                local cash = Paper.Stats.GetValue("Cash") or 0
                local rebirth = Paper.Stats.GetValue("Rebirth") or 0
                
                local reqChickens = Chickens.GetUpgTierReq(tier)
                local reqCost = Chickens.GetUpgTierCost(tier)

                if reqChickens and reqCost then
                    local canAfford = (total >= reqChickens) and (cash >= reqCost) and (tier < rebirth * 2)
                    if canAfford then
                        Network.InvokeServer("Upgrade Buy Tier Level")
                    end
                end
            end)
        end

        task.wait(0.2)
    end
end)

-- 2. cash collector & ad exploits
task.spawn(function()
    while true do
        if State.AutoCash then
            pcall(function()
                Network.InvokeServer("Collect Cash")
                Network.InvokeServer("Claim Cash Rewards")
                Network.InvokeServer("Claim Offline Earnings")
                Network.InvokeServer("Claim Group Reward")
            end)
        end
        if State.AutoAdExploit then
            pcall(function()
                Network.InvokeServer("Watch Ad", "Instant Process")
                Network.InvokeServer("Watch Ad", "Offline Rewards")
            end)
        end
        if State.AutoObby then
            pcall(function()
                Network.InvokeServer("Claim Obby")
            end)
        end
        task.wait(State.TickDelay)
    end
end)

-- 3. vacuum eggs & deposit
task.spawn(function()
    while true do
        if State.AutoEggs and not State.AutoClearEggs then
            pcall(function()
                for _, egg in ipairs(eggsFolder:GetChildren()) do
                    Network.FireServer("Collect Egg", egg.Name)
                end
            end)
        end
        if State.AutoDeposit then
            pcall(function()
                Network.InvokeServer("Deposit Eggs")
            end)
        end
        task.wait(0.2)
    end
end)

-- 4. general progression
task.spawn(function()
    while true do
        if State.AutoRebirth then
            pcall(function()
                local r = Paper.Stats.GetValue("Rebirth") or 0
                local c = Paper.Stats.GetValue("Cash") or 0
                local req = Chickens.GetRebirthReq(r + 1)
                if req and c >= req then
                    Network.InvokeServer("Rebirth")
                end
            end)
        end
        if State.AutoMerge then
            pcall(function()
                Network.InvokeServer("Merge Chickens")
            end)
        end
        if State.AutoUpgradeProcess then
            pcall(function()
                Network.InvokeServer("Upgrade Process Level")
            end)
        end
        if State.AutoLuckyBlock then
            pcall(function()
                Network.InvokeServer("Open Lucky Block")
                Network.FireServer("Claim Opened Chicken")
            end)
        end
        task.wait(0.8)
    end
end)


